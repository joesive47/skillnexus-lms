# =============================================================
# Production Environment Variables — Vercel
# =============================================================
# คัดลอกค่าเหล่านี้ไปตั้งใน:
#   Vercel Dashboard → Project → Settings → Environment Variables
# =============================================================

# ── Database (Required) ──────────────────────────────────────
# แนะนำ: Vercel Postgres, Neon, Supabase, Railway
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── NextAuth (Required) ──────────────────────────────────────
# สร้าง secret ด้วย: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-32-random-chars"
NEXTAUTH_URL="https://YOUR-APP.vercel.app"
AUTH_SECRET="replace-with-32-random-chars"
AUTH_URL="https://YOUR-APP.vercel.app"

# ── Google OAuth (Optional) ──────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Email — Resend (Optional) ────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"

# ── Stripe Payments (Optional) ───────────────────────────────
STRIPE_SECRET_KEY="sk_live_xxxxxxxxxxxx"
STRIPE_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxx"

# ── Redis / Upstash (Optional) ───────────────────────────────
REDIS_URL="redis://default:PASSWORD@HOST.upstash.io:6379"

# ── AWS S3 File Storage (Optional) ───────────────────────────
AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXX"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_REGION="ap-southeast-1"
S3_BUCKET="your-bucket-name"
AWS_S3_BACKUP_BUCKET="your-backup-bucket"

# ── Cloudinary (Optional) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ── AI Services (Optional) ───────────────────────────────────
OPENAI_API_KEY="sk-xxxxxxxxxxxx"
AI_KEY_ENCRYPTION_SECRET="replace-with-32-random-chars"

# ── Security (Optional) ──────────────────────────────────────
ENCRYPTION_KEY="replace-with-32-random-chars"
CERT_SIGNING_KEY="replace-with-32-random-chars"
ALLOWED_ORIGINS="https://YOUR-APP.vercel.app"

# ── Sentry Error Monitoring (Optional) ───────────────────────
SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
SENTRY_ORG="your-org"
SENTRY_PROJECT="your-project"

# ── Build Optimization (Recommended) ─────────────────────────
NODE_OPTIONS="--max-old-space-size=3072"
NEXT_TELEMETRY_DISABLED="1"
SKIP_ENV_VALIDATION="true"
